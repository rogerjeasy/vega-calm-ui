{
  // Type-checks everything: the source, its tests, and the ESLint plugin's
  // plain-JS rules (checked through their JSDoc). tsconfig.build.json emits
  // only src, without the tests, into dist.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["node"],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,

    // The Vega SDK ships raw .ts beside its own .d.ts, and TypeScript resolves
    // .ts first, so the SDK is type-checked as if it were this package's code
    // and fails this one check. Off here so the rest of `strict` can stay on.
    "noUncheckedIndexedAccess": false
  },
  "include": ["src/**/*", "eslint/**/*", "eslint.config.js", "vitest.config.ts"]
}
