{
  "name": "vega-calm-ui",
  "version": "0.1.2",
  "description": "Accessible, low-arousal 10-foot components for Vega OS and Fire TV: 32pt type, 7:1 contrast, three actions at most, no red, no timers. Enforced at render time and by ESLint.",
  "license": "MIT",
  "author": "Roger Bavibidila (https://github.com/rogerjeasy)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./eslint": {
      "types": "./eslint/index.d.ts",
      "default": "./eslint/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/__tests__",
    "eslint",
    "CHANGELOG.md"
  ],
  "keywords": [
    "vega-os",
    "vega",
    "kepler",
    "fire-tv",
    "react-native",
    "react-native-tvos",
    "tv",
    "10-foot-ui",
    "accessibility",
    "a11y",
    "wcag",
    "eslint-plugin",
    "older-adults"
  ],
  "homepage": "https://github.com/rogerjeasy/vega-calm-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerjeasy/vega-calm-ui.git"
  },
  "bugs": {
    "url": "https://github.com/rogerjeasy/vega-calm-ui/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "prepack": "npm run build",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@amazon-devices/react-native-kepler": ">=4.0.0",
    "eslint": ">=9.0.0",
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@amazon-devices/react-native-kepler": {
      "optional": true
    },
    "eslint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@amazon-devices/react-native-kepler": "^4.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "eslint": "^9.39.0",
    "react": "^19.2.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.2.0"
  }
}
